{
  "capabilities": [
    {
      "id": "calsync",
      "command": "node",
      "args": [
        "apps/cli/dist/cli.js",
        "mcp"
      ],
      "cwd": "/path/to/calsync-oss",
      "manifestPath": "/path/to/calsync-oss/apps/cli/capability.json",
      "secretsAccess": "broker",
      "denyTools": [
        "sync_now"
      ]
    },
    {
      "id": "weather",
      "command": "node",
      "args": [
        "mcp/server.mjs"
      ],
      "cwd": "/path/to/weather-patterns",
      "manifestPath": "/path/to/weather-patterns/capability.json",
      "secretsAccess": "broker"
    },
    {
      "id": "fitness",
      "command": "node",
      "args": [
        "mcp/server.mjs"
      ],
      "cwd": "/path/to/fitness-tracker",
      "manifestPath": "/path/to/fitness-tracker/capability.json",
      "secretsAccess": "broker",
      "env": {
        "FITNESS_DB": "/path/to/fitness-tracker/workouts.json",
        "FITNESS_GAPS": "/path/to/fitness-tracker/gaps.json"
      }
    }
  ],
  "audit": {
    "maxBytes": 5242880,
    "keepFiles": 5
  },
  "commons": {
    "dir": "/path/to/fitness-tracker/data"
  },
  "oauth": {
    "google": {
      "envFile": "/path/to/calsync-oss/.env"
    }
  },
  "links": [
    {
      "href": "https://mail.example.com",
      "label": "MailFeed",
      "badge": "beta",
      "accent": "marigold",
      "tagline": "Your reading list, owned by you.",
      "description": "Turn your emails into a reading feed with full article text, search, and smart link extraction.",
      "highlights": [
        "Email yourself a link; it lands in your feed",
        "Full article text, with Wayback fallback",
        "Search and chat across what you saved"
      ],
      "repo": "https://github.com/toothbrush-inc/mailfeed"
    }
  ],
  "store": {
    "name": "Toy Box",
    "headline": "Daily apps to improve your day",
    "contact": {
      "email": "you@example.com",
      "byline": "Built and run by one person for family and friends"
    }
  }
}
