{
  "name": "@local/capability-gateway",
  "version": "0.11.0",
  "private": false,
  "description": "One sign-in, one place, and every app also works from your AI assistant. An MCP gateway that mounts capability servers, holds the keys, enforces grants and tool policy, audits every call, and serves the app store page.",
  "type": "module",
  "bin": {
    "capability-gateway": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "SECURITY.md",
    "gateway.config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dvd-toy-box/vault": "^0.12.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidd8/capability-gateway.git"
  },
  "license": "MIT"
}
